{
  "name": "osrs-companion",
  "version": "1.0.2",
  "description": "OSRS companion MCP - wiki search, GE prices, and local player data for AI assistants",
  "type": "module",
  "bin": {
    "osrs-companion": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && mkdir -p dist/data && cp src/data/*.json dist/data/",
    "start": "node dist/index.js",
    "start:ingest": "node dist/ingest.js",
    "dev": "tsx src/index.ts",
    "dev:ingest": "tsx src/ingest.ts",
    "backfill:wom": "node dist/scripts/womBackfill.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "osrs",
    "runescape",
    "runelite",
    "mcp",
    "model-context-protocol",
    "wiki",
    "ai"
  ],
  "license": "BSD-2-Clause",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^24.5.2",
    "tsx": "^4.23.1",
    "typescript": "5.9.2"
  }
}
