# Bearer token the RuneLite plugin must present (Authorization: Bearer
# <token>) to POST snapshots to the ingest endpoint's /snapshot route.
# Generate one with: openssl rand -hex 32
INGEST_TOKEN=

# --- Only needed if you run mcp-oauth-proxy in front of the MCP server ---

# Your OIDC provider's issuer URL for the application you create for this
# server (see README "Deploying with Docker + OAuth"). Must end with / and
# <issuer>/.well-known/openid-configuration must resolve.
OIDC_ISSUER_URL=

# The public HTTPS URL your reverse proxy exposes mcp-oauth-proxy on.
MCP_PUBLIC_URL=

# Client ID / secret of the OAuth2/OIDC application you create for this
# server. Most self-hosted OIDC providers don't support open Dynamic
# Client Registration (which MCP clients like claude.ai expect), so this
# uses one pre-created, static client instead.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Group (or equivalent) your OIDC provider uses to gate access to this
# application, if it supports group-based access policies.
ALLOW_GROUPS=mcp-users

# Host ports to publish - change if they collide with something else.
INGEST_HOST_PORT=8094
MCP_HOST_PORT=8096
